# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# IPINFO_TOKEN: Optional API token for enhanced IP geolocation and ASN/VPN lookup via ipinfo.io
IPINFO_TOKEN=""

# VISITOR_HMAC_SECRET: Server-side secret used to sign visitor access tokens and protect visitor records
VISITOR_HMAC_SECRET="veritrace-first-party-hmac-secret-key"
