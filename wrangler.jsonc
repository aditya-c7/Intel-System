{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "intel-system",
  "main": "build/worker/index.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build && node scripts/build-worker.mjs",
    "watch_dir": ["worker", "server.ts", "src", "scripts/build-worker.mjs"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // run_worker_first MUST stay true. The Worker has to see every request before the asset
    // layer: it performs SSR bot-verdict injection into documents (intel:verdict / intel:bot-type
    // meta tags, the #intel-initial-verdict JSON script, X-Intel-Bot-* headers and the 60s WBA
    // intel_wba cookie) and routes /api/* to the Express app. With single-page-application
    // not-found handling, serving assets first would return index.html for every path and the
    // Worker would never run, so no injection or API routing would happen. Files that need no
    // rewriting are explicitly forwarded to ASSETS by worker/index.js (/assets/*, /robots.txt,
    // /llms.txt, /agents.md, /sitemap.xml). Tradeoff: every request, including static assets,
    // invokes the Worker. Setting this to false breaks SSR verdict injection (see CLOUDFLARE.md).
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "VISITOR_STORE", "class_name": "VisitorStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisitorStore"] },
    { "tag": "v2", "new_sqlite_classes": ["SpeedTestStore"] },
    { "tag": "v3", "deleted_classes": ["SpeedTestStore"] }
  ],
  // Native Cloudflare Workers rate limiter. Top-level `ratelimits` is the documented schema;
  // period must be 10 or 60 seconds. The binding is optional at runtime (worker/index.js
  // fails open when absent), so a local/Express run is unaffected.
  "ratelimits": [
    {
      "name": "IDENTIFY_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 40, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
