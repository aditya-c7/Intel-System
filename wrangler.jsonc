{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "intel-system",
  "main": "build/worker/index.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build && node scripts/build-worker.mjs",
    "watch_dir": ["worker", "server.ts", "src", "scripts/build-worker.mjs"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Selective Worker-first routing (array form, supported by Wrangler >= 4.20 and verified
    // against the 4.161.0 pinned in scripts/test-worker.mjs). `/*` is a deep glob: Wrangler
    // confirms it already matches `/`, so a separate `/` rule is rejected as redundant.
    // It keeps the Worker ahead of the asset layer for `/`, every API route (/api/* included)
    // and every document / SPA deep link, so SSR bot-verdict injection stays intact:
    // intel:verdict / intel:bot-type meta tags, the #intel-initial-verdict JSON script,
    // X-Intel-Bot-* headers and the 60s WBA intel_wba cookie. With single-page-application
    // not-found handling, narrowing the positive patterns to literal documents would let the
    // asset layer serve index.html for deep links before the Worker ever ran.
    // Negative patterns take precedence: immutable hashed assets and crawler / LLM metadata
    // files are served verbatim by the asset layer (their own caching wins) and no longer cost a
    // Worker invocation. worker/index.js keeps its matching pass-through branches as a fallback.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/robots.txt",
      "!/llms.txt",
      "!/agents.md",
      "!/sitemap.xml"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "VISITOR_STORE", "class_name": "VisitorStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisitorStore"] },
    { "tag": "v2", "new_sqlite_classes": ["SpeedTestStore"] },
    { "tag": "v3", "deleted_classes": ["SpeedTestStore"] }
  ],
  // Native Cloudflare Workers rate limiter. Top-level `ratelimits` is the documented schema;
  // period must be 10 or 60 seconds. The binding is optional at runtime (worker/index.js
  // fails open when absent), so a local/Express run is unaffected.
  "ratelimits": [
    {
      "name": "IDENTIFY_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 40, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
